@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Account settings</span>
      <h2>Change Password</h2>
    </div>

    @if (TempData["FormSuccess"] != null)
    {
        <div class="form-success">@TempData["FormSuccess"]</div>
    }

    <div class="form-centered">
      <form class="contact-form" asp-action="ChangePassword" asp-controller="Account" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row">
          <label asp-for="CurrentPassword"></label>
          <input asp-for="CurrentPassword" />
          <span asp-validation-for="CurrentPassword" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="NewPassword"></label>
          <input asp-for="NewPassword" />
          <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="ConfirmNewPassword"></label>
          <input asp-for="ConfirmNewPassword" />
          <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn-dark">Update password</button>
      </form>
    </div>
  </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
