@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Reset access</span>
      <h2>Forgot your password?</h2>
      <p>Enter the email on your account and we'll send you a verification code.</p>
    </div>

    <div class="form-centered">
      <form class="contact-form" asp-action="ForgotPassword" asp-controller="Account" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row">
          <label asp-for="Email"></label>
          <input asp-for="Email" placeholder="you@@example.com" />
          <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <button type="submit" class="btn-dark">Send verification code</button>
      </form>
      <p style="text-align:center; margin-top:16px; font-size:0.9rem;">
        <a href="/login">Back to log in</a>
      </p>
    </div>
  </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
