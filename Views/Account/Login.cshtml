@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
    ViewData["ActivePage"] = "Login";
}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Welcome back</span>
      <h2>Log in</h2>
      <p>Enter your email and password to access your account.</p>
    </div>

    @if (TempData["FormSuccess"] != null)
    {
        <div class="form-success">@TempData["FormSuccess"]</div>
    }

    <div class="form-centered">
      <form class="contact-form" asp-action="Login" asp-controller="Account" method="post" asp-route-returnUrl="@ViewData["ReturnUrl"]">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row">
          <label asp-for="Email"></label>
          <input asp-for="Email" placeholder="you@@example.com" />
          <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="Password"></label>
          <input asp-for="Password" placeholder="Your password" />
          <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="form-row" style="display:flex; align-items:center; gap:8px;">
          <input asp-for="RememberMe" style="width:auto;" />
          <label asp-for="RememberMe" style="margin:0;"></label>
        </div>
<p style="text-align:right; margin:-8px 0 20px; font-size:0.85rem;">
  <a href="/forgot-password">Forgot your password?</a>
</p>



        <button type="submit" class="btn-dark">Log in</button>
      </form>
      <p style="text-align:center; margin-top:16px; font-size:0.9rem;">
        Don't have an account? <a href="/register">Register here</a>.
      </p>
    </div>
  </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
