@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    ViewData["ActivePage"] = "Register";
}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Create an account</span>
      <h2>Register</h2>
      <p>Choose your role and set up your login.</p>
    </div>

    @if (TempData["FormSuccess"] != null)
    {
        <div class="form-success">@TempData["FormSuccess"]</div>
    }

    <div class="form-centered">
      <form class="contact-form" asp-action="Register" asp-controller="Account" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row">
          <label asp-for="FullName"></label>
          <input asp-for="FullName" placeholder="Your full name" />
          <span asp-validation-for="FullName" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="Email"></label>
          <input asp-for="Email" placeholder="you@@example.com" />
          <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="Password"></label>
          <input asp-for="Password" placeholder="At least 6 characters" />
          <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="ConfirmPassword"></label>
          <input asp-for="ConfirmPassword" placeholder="Re-enter password" />
          <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="RoleId"></label>
          <select asp-for="RoleId">
            <option value="">Select a role</option>
            @foreach (var role in (List<Role>)ViewBag.Roles)
            {
                <option value="@role.Id">@role.Name</option>
            }
          </select>
          <span asp-validation-for="RoleId" class="field-error"></span>
        </div>

        <button type="submit" class="btn-dark">Create account</button>
      </form>
    </div>
  </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}