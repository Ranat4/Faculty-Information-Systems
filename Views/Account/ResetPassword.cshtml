@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Reset access</span>
      <h2>Set a new password</h2>
    </div>

    <div class="form-centered">
      <form class="contact-form" asp-action="ResetPassword" asp-controller="Account" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Code" />

        <div class="form-row">
          <label asp-for="NewPassword"></label>
          <input asp-for="NewPassword" />
          <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="ConfirmNewPassword"></label>
          <input asp-for="ConfirmNewPassword" />
          <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn-dark">Reset password</button>
      </form>
    </div>
  </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
