@model List<FacultyInformationSystem_FIS_.Models.DemoRequest>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Demo Requests — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        :root {
            --gold: #C5A63E;
            --gold-dark: #A6872B;
            --ink: #181818;
        }
        body {
            background: #F3F4F6;
            font-family: 'Inter', Arial, sans-serif;
            color: var(--ink);
        }
        .page-header {
             background: linear-gradient(120deg, #E9D9A0, var(--gold));
             padding: 36px 40px;
        }
        .page-header h1 {
            font-weight: 800;
            font-size: 1.6rem;
            margin: 0;
            color: var(--ink);
        }
        .page-header p {
            margin: 6px 0 0;
            color: #4A3E12;
            font-size: 0.92rem;
        }
        .content-wrap {
            max-width: 1200px;
            margin: 0 auto;
            padding: 32px 24px 60px;
        }
        .table-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(24,24,24,0.08);
            padding: 28px;
        }
        .badge-status {
            font-weight: 600;
            font-size: 0.72rem;
            padding: 6px 12px;
            border-radius: 999px;
            letter-spacing: 0.02em;
        }
        .badge-status-New { background:#E9ECEF; color:#495057; }
        .badge-status-Read { background:#CFE2FF; color:#0B4FA8; }
        .badge-status-Responded { background:#D1F2E0; color:#137047; }
        .badge-status-Closed { background:#212529; color:#fff; }

        table.dataTable thead th {
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: #6c757d;
            border-bottom: 2px solid #eee !important;
        }
        table.dataTable tbody td {
            vertical-align: middle;
            font-size: 0.9rem;
        }
        .btn-icon {
            width: 34px; height: 34px;
            display: inline-flex; align-items: center; justify-content: center;
            border-radius: 8px;
            padding: 0;
        }
        .action-group { display: flex; gap: 6px; }

        .dataTables_wrapper .dataTables_filter input,
        .dataTables_wrapper .dataTables_length select {
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }
        .modal-header { background: #FAF7EF; }
        .modal-title { font-weight: 700; }
    </style>
</head>
<body>

<div class="page-header">
    <h1>Demo Requests</h1>
    <p>Every submission from the Request Demo form, in one place.</p>
</div>

<div class="content-wrap">
    <div class="table-card">
        <table id="requestsTable" class="table table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Institution</th>
                    <th>Status</th>
                    <th>Submitted</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-semibold">@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.Institution</td>
                    <td><span class="badge-status badge-status-@item.Status">@item.Status</span></td>
                    <td>@item.SubmittedAt.ToString("MMM d, yyyy · h:mm tt")</td>
                    <td>
                        <div class="action-group justify-content-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon" title="View" data-bs-toggle="modal" data-bs-target="#viewModal-@item.Id">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary btn-icon" title="Edit" data-bs-toggle="modal" data-bs-target="#editModal-@item.Id">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <form method="post" action="/admin/demo-requests/@item.Id/delete" class="d-inline"
                                  onsubmit="return confirm('Delete the request from @item.Name? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>

                <!-- View Details modal -->
                <div class="modal fade" id="viewModal-@item.Id" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h5 class="modal-title">Request from @item.Name</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <p class="mb-2"><strong>Email:</strong> @item.Email</p>
                        <p class="mb-2"><strong>Institution:</strong> @item.Institution</p>
                        <p class="mb-2"><strong>Status:</strong> <span class="badge-status badge-status-@item.Status">@item.Status</span></p>
                        <p class="mb-2"><strong>Submitted:</strong> @item.SubmittedAt.ToString("MMM d, yyyy · h:mm tt")</p>
                        <hr>
                        <p class="mb-1"><strong>Message:</strong></p>
                        <p style="white-space:pre-line;">@item.Message</p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Edit modal -->
                <div class="modal fade" id="editModal-@item.Id" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <form method="post" action="/admin/demo-requests/@item.Id/edit">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                          <h5 class="modal-title">Edit Request</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" name="name" value="@item.Name" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input class="form-control" type="email" name="email" value="@item.Email" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Institution</label>
                            <input class="form-control" name="institution" value="@item.Institution" required />
                          </div>
                          <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" name="message" rows="4" required>@item.Message</textarea>
                          </div>
                          <div class="mb-1">
                            <label class="form-label">Status</label>
                            <select class="form-select" name="status">
                              <option value="New" selected="@(item.Status == "New")">New</option>
                              <option value="Read" selected="@(item.Status == "Read")">Read</option>
                              <option value="Responded" selected="@(item.Status == "Responded")">Responded</option>
                              <option value="Closed" selected="@(item.Status == "Closed")">Closed</option>
                            </select>
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                          <button type="submit" class="btn btn-dark">Save changes</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
            }
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function () {
        $('#requestsTable').DataTable({
            order: [[4, 'desc']]
        });
    });
</script>
</body>
</html>
