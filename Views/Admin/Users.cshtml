@model List<FacultyInformationSystem_FIS_.Models.User>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users — Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <style>
        :root { --gold: #C5A63E; --gold-dark: #A6872B; --ink: #181818; }
        body { background: #F3F4F6; font-family: 'Inter', Arial, sans-serif; color: var(--ink); }
        .page-header { background: linear-gradient(120deg, #E9D9A0, var(--gold)); padding: 36px 40px; }
        .page-header h1 { font-weight: 800; font-size: 1.6rem; margin: 0; color: var(--ink); }
        .page-header p { margin: 6px 0 0; color: #4A3E12; font-size: 0.92rem; }
        .content-wrap { max-width: 1100px; margin: 0 auto; padding: 32px 24px 60px; }
        .table-card { background: #fff; border-radius: 16px; box-shadow: 0 10px 30px rgba(24,24,24,0.08); padding: 28px; }
        .badge-role { font-weight: 600; font-size: 0.72rem; padding: 6px 12px; border-radius: 999px; }
        .badge-role-Administrator { background:#212529; color:#fff; }
        .badge-role-Student { background:#CFE2FF; color:#0B4FA8; }
        table.dataTable thead th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: #6c757d; border-bottom: 2px solid #eee !important; }
        table.dataTable tbody td { vertical-align: middle; font-size: 0.9rem; }
    </style>
</head>
<body>

<div class="page-header">
    <h1>Registered Users</h1>
    <p>Every account registered in the system, with their assigned role.</p>
</div>

<div class="content-wrap">
    <div class="table-card">
        <table id="usersTable" class="table table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Registered</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="fw-semibold">@user.FullName</td>
                    <td>@user.Email</td>
                    <td>
                        @foreach (var ur in user.UserRoles)
                        {
                            <span class="badge-role badge-role-@ur.Role.Name">@ur.Role.Name</span>
                        }
                    </td>
                    <td>@user.CreatedAt.ToString("MMM d, yyyy · h:mm tt")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script>
    $(document).ready(function () {
        $('#usersTable').DataTable({ order: [[3, 'desc']] });
    });
</script>
</body>
</html>
