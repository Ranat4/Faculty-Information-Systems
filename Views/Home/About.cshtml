@{
    ViewData["Title"] = "About Us";
    ViewData["ActivePage"] = "About";
}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">About Us</span>
      <h2>Built to keep faculty records in one place</h2>
    </div>

    <p class="about-lede">
      The Faculty Information System started as a class project with a simple
      goal: give a university one shared system for the records that
      normally live scattered across spreadsheets, email threads, and paper
      forms — faculty profiles, department assignments, course enrollment,
      research output, and leave requests.
    </p>

    <div class="value-grid">
      <div class="value-card">
        <h3>One source of truth</h3>
        <p>Every module reads and writes to the same faculty and department data, so records never fall out of sync between offices.</p>
      </div>
      <div class="value-card">
        <h3>Built around roles</h3>
        <p>Administrators, faculty, and students each get the tools relevant to them, without needing separate systems.</p>
      </div>
      <div class="value-card">
        <h3>Less paperwork</h3>
        <p>Leave requests, enrollment changes, and reports move through the system instead of email and printed forms.</p>
      </div>
    </div>

    <div class="section-head" style="margin-top:24px;">
      <span class="eyebrow">The team</span>
      <h2>Who built this</h2>
      <p>A two-person team, each responsible for a different half of the project.</p>
    </div>

    <div class="team-grid">
      <div class="team-card">
        <div class="team-avatar">D</div>
        <h3>Dinar</h3>
        <span>Home Page &amp; Core Modules</span>
        <p>Home Page design, plus User &amp; Role, Faculty Profile, Department, Enrollment, Report, Research, Notification, and Leave Management.</p>
      </div>
      <div class="team-card">
        <div class="team-avatar">R</div>
        <h3>Rana</h3>
        <span>About, FAQ &amp; Contact</span>
        <p>Designed and built the About Us, FAQ, and Contact pages.</p>
      </div>
    </div>
  </div>
</section>
