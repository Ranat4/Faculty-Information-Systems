@model ContactFormViewModel
@{
    ViewData["Title"] = "Contact";
    ViewData["ActivePage"] = "Contact";
}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Get in touch</span>
      <h2>Contact</h2>
      <p>Have a question? Send us a message and we'll get back to you.</p>
    </div>

    @if (TempData["FormSuccess"] != null)
    {
        <div class="form-success">@TempData["FormSuccess"]</div>
    }

    <div class="contact-grid">
      <form asp-controller="Home"
            asp-action="Contact"
            method="post"
            class="contact-form">

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row">
          <label asp-for="Name"></label>
          <input asp-for="Name" placeholder="Your name" />
          <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="Email"></label>
          <input asp-for="Email" placeholder="you@@example.com" />
          <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-row">
          <label asp-for="Message"></label>
          <textarea asp-for="Message" placeholder="How can we help?"></textarea>
          <span asp-validation-for="Message" class="field-error"></span>
        </div>
        <p class="form-note">We will get back to you as soon as possible.</p>
        <button type="submit" class="btn-dark">Send message</button>
      </form>

      <div class="contact-info">
        <div class="info-card">
          <h4>Email</h4>
          <p>support@@fis.edu</p>
        </div>
        <div class="info-card">
          <h4>Department</h4>
          <p>Faculty Affairs Office<br>Main Campus Administration Building</p>
        </div>
        <div class="info-card">
          <h4>Office hours</h4>
          <p>Monday–Friday, 9:00 AM–4:00 PM</p>
        </div>
      </div>
    </div>
  </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
