@model IEnumerable<FacultyInformationSystem_FIS_.Models.Role>

@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Role Management";
    ViewData["ActivePanelPage"] = "Role Management";
}

<style>
    .role-page {
        max-width: 1200px;
        margin: 0 auto;
    }

    .role-page-intro {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 28px;
        gap: 20px;
    }

        .role-page-intro h2 {
            margin: 0 0 6px;
            color: #181818;
            font-size: 1.45rem;
            font-weight: 800;
        }

        .role-page-intro p {
            margin: 0;
            color: #777;
            font-size: 0.9rem;
        }

    .add-role-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #C5A63E;
        color: #181818;
        text-decoration: none;
        padding: 11px 18px;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 700;
        transition: 0.2s ease;
        white-space: nowrap;
    }

        .add-role-btn:hover {
            background: #b39532;
            color: #181818;
            transform: translateY(-1px);
        }

    .role-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .summary-label {
        color: #777;
        font-size: 0.82rem;
        margin-bottom: 6px;
    }

    .summary-value {
        color: #181818;
        font-size: 1.5rem;
        font-weight: 800;
    }

    .summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 8px;
        background: rgba(197, 166, 62, 0.12);
        color: #C5A63E;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 1.1rem;
    }

    .roles-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        overflow: hidden;
    }

    .roles-card-header {
        padding: 20px 24px;
        background: #fff;
        border-bottom: 1px solid #e8e8e8;
    }

        .roles-card-header h3 {
            margin: 0 0 5px;
            color: #181818;
            font-size: 1rem;
            font-weight: 800;
        }

        .roles-card-header p {
            margin: 0;
            color: #888;
            font-size: 0.82rem;
        }

    .roles-table {
        width: 100%;
        border-collapse: collapse;
    }

        .roles-table th {
            background: #F3F4F6;
            color: #555;
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            padding: 13px 24px;
            text-align: left;
        }

        .roles-table td {
            padding: 17px 24px;
            border-top: 1px solid #eeeeee;
            color: #333;
            font-size: 0.87rem;
        }

        .roles-table tbody tr {
            transition: background 0.15s ease;
        }

            .roles-table tbody tr:hover {
                background: rgba(197, 166, 62, 0.045);
            }

    .role-name {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .role-avatar {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background: #181818;
        color: #E9D9A0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.82rem;
    }

    .role-name strong {
        display: block;
        color: #181818;
        font-weight: 700;
    }

    .role-id {
        display: block;
        margin-top: 3px;
        color: #999;
        font-size: 0.72rem;
    }

    .description {
        color: #777;
    }

    .access-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 6px;
        background: #F3F4F6;
        border: 1px solid #e4e4e4;
        color: #555;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 11px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 0.76rem;
        font-weight: 600;
        transition: 0.2s ease;
    }

    .edit-btn {
        border: 1px solid #d8d8d8;
        color: #333;
        background: #fff;
    }

        .edit-btn:hover {
            border-color: #C5A63E;
            color: #181818;
            background: rgba(197, 166, 62, 0.08);
        }

    .permission-btn {
        border: 1px solid #20303D;
        color: #20303D;
        background: #fff;
    }

        .permission-btn:hover {
            background: #20303D;
            color: #fff;
        }

    @@media (max-width: 850px) {
        .role-summary {
            grid-template-columns: 1fr;
        }

        .role-page-intro {
            align-items: flex-start;
            flex-direction: column;
        }

        .roles-card {
            overflow-x: auto;
        }

        .roles-table {
            min-width: 750px;
        }
    }
</style>

<div class="role-page">

    <!-- Header -->
    <div class="role-page-intro">
        <div>
            <h2>Manage Roles</h2>
            <p>
                Create roles and manage their access to system modules.
            </p>
        </div>

        <a asp-controller="RoleManagement"
           asp-action="Create"
           class="add-role-btn">
            <span>+</span>
            Add New Role
        </a>
        </div>

    <!-- Summary -->
    <div class="role-summary">

        <div class="summary-card">
            <div>
                <div class="summary-label">Total Roles</div>
                <div class="summary-value">@Model.Count()</div>
            </div>

            <div class="summary-icon">
                R
            </div>
        </div>


        <div class="summary-card">
            <div>
                <div class="summary-label">Available Modules</div>
                <div class="summary-value">
                    @System.Enum.GetValues(typeof(FacultyInformationSystem_FIS_.Models.Modules)).Length
                </div>
            </div>

            <div class="summary-icon">
                M
            </div>
        </div>


        <div class="summary-card">
            <div>
                <div class="summary-label">Access Records</div>
                <div class="summary-value">
                    @Model.Sum(r => r.RoleAccesses.Count)
                </div>
            </div>

            <div class="summary-icon">
                A
            </div>
        </div>

    </div>


    <!-- Roles -->
    <div class="roles-card">

        <div class="roles-card-header">
            <h3>Existing Roles</h3>
            <p>
                View and manage the roles currently available in the system.
            </p>
        </div>


        <div style="overflow-x:auto;">

            <table class="roles-table">

                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Description</th>
                        <th>Access</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var role in Model)
                    {
                        <tr>

                            <td>
                                <div class="role-name">

                                    <div class="role-avatar">
                                        @role.Name.Substring(0, 1).ToUpper()
                                    </div>

                                    <div>
                                        <strong>@role.Name</strong>

                                        <span class="role-id">
                                            Role ID: @role.Id
                                        </span>
                                    </div>

                                </div>
                            </td>


                            <td>
                                <span class="description">
                                    @(string.IsNullOrWhiteSpace(role.Description)
                                        ? "No description available"
                                        : role.Description)
                                </span>
                            </td>


                            <td>
                                <span class="access-badge">
                                    @role.RoleAccesses.Count access record(s)
                                </span>
                            </td>


                            <td>

                                <div class="action-buttons">

                                    <a asp-action="Edit"
                                       asp-route-id="@role.Id"
                                       class="action-btn edit-btn">
                                        Edit
                                    </a>

                                    <a asp-action="Permissions"
                                       asp-route-id="@role.Id"
                                       class="action-btn permission-btn">
                                        Permissions
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>