@model FacultyInformationSystem_FIS_.Models.Role

@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Manage Permissions";
}

<style>
    .permissions-page {
        max-width: 1000px;
        margin: 0 auto;
    }

    .permissions-header {
        margin-bottom: 24px;
    }

        .permissions-header h2 {
            margin: 0 0 6px;
            color: #181818;
            font-size: 1.45rem;
            font-weight: 800;
        }

        .permissions-header p {
            margin: 0;
            color: #777;
            font-size: 0.88rem;
        }

    .role-info-card {
        background: #20303D;
        color: #fff;
        border-radius: 10px;
        padding: 20px 24px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .role-icon {
        width: 44px;
        height: 44px;
        border-radius: 8px;
        background: #C5A63E;
        color: #181818;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .role-info-card h3 {
        margin: 0 0 4px;
        font-size: 1rem;
        font-weight: 800;
    }

    .role-info-card p {
        margin: 0;
        color: #C9C6BC;
        font-size: 0.78rem;
    }

    .permissions-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 10px;
        overflow: hidden;
    }

    .permissions-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e8e8e8;
    }

        .permissions-card-header h3 {
            margin: 0 0 5px;
            color: #181818;
            font-size: 1rem;
            font-weight: 800;
        }

        .permissions-card-header p {
            margin: 0;
            color: #888;
            font-size: 0.8rem;
        }

    .permissions-table {
        width: 100%;
        border-collapse: collapse;
    }

        .permissions-table th {
            background: #F3F4F6;
            color: #555;
            font-size: 0.76rem;
            font-weight: 700;
            text-transform: uppercase;
            padding: 13px 24px;
            text-align: left;
        }

        .permissions-table td {
            padding: 18px 24px;
            border-top: 1px solid #eeeeee;
            font-size: 0.86rem;
        }

    .module-name {
        color: #181818;
        font-weight: 700;
    }

    .module-description {
        display: block;
        color: #999;
        font-size: 0.74rem;
        margin-top: 4px;
    }

    .access-select {
        width: 220px;
        padding: 9px 12px;
        border: 1px solid #d8d8d8;
        border-radius: 8px;
        background: #fff;
        color: #181818;
        font-family: 'Inter', Arial, sans-serif;
        font-size: 0.82rem;
        outline: none;
    }

        .access-select:focus {
            border-color: #C5A63E;
            box-shadow: 0 0 0 3px rgba(197, 166, 62, 0.12);
        }

    .permissions-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 20px 24px;
        border-top: 1px solid #eeeeee;
    }

    .back-btn,
    .save-permissions-btn {
        padding: 10px 18px;
        border-radius: 8px;
        font-family: 'Inter', Arial, sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
    }

    .back-btn {
        border: 1px solid #d8d8d8;
        color: #555;
        background: #fff;
    }

        .back-btn:hover {
            background: #F3F4F6;
            color: #181818;
        }

    .save-permissions-btn {
        border: 1px solid #C5A63E;
        background: #C5A63E;
        color: #181818;
    }

        .save-permissions-btn:hover {
            background: #b39532;
            border-color: #b39532;
        }

    @@media (max-width: 700px) {
        .permissions-table {
            min-width: 650px;
        }

        .permissions-card {
            overflow-x: auto;
        }
    }
</style>


<div class="permissions-page">

    <div class="permissions-header">
        <h2>Manage Permissions</h2>
        <p>
            Manage module access levels assigned to this role.
        </p>
    </div>


    <div class="role-info-card">

        <div class="role-icon">
            @Model.Name.Substring(0, 1).ToUpper()
        </div>

        <div>
            <h3>@Model.Name</h3>

            <p>
                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description available"
                    : Model.Description)
            </p>
        </div>

    </div>


    <form asp-action="Permissions"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <div class="permissions-card">

            <div class="permissions-card-header">

                <h3>Module Access</h3>

                <p>
                    Select the access level for each available system module.
                </p>

            </div>


            <div style="overflow-x:auto;">

                <table class="permissions-table">

                    <thead>
                        <tr>
                            <th>Module</th>
                            <th>Access Level</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var module in Enum.GetValues<FacultyInformationSystem_FIS_.Models.Modules>())
                        {
                            var currentAccess = Model.RoleAccesses
                                .FirstOrDefault(ra => ra.Module == module);

                            <tr>

                                <td>
                                    <span class="module-name">
                                        @module
                                    </span>

                                    <span class="module-description">
                                        System module access
                                    </span>
                                </td>

                                <td>

                                    <select class="access-select"
                                            name="access_@module">

                                        <option value=""
                                                selected="@(currentAccess == null ? "selected" : null)">
                                            No Access
                                        </option>

                                        @foreach (var access in Enum.GetValues<FacultyInformationSystem_FIS_.Models.AccessType>())
                                        {
                                            <option value="@access"
                                                    selected="@(currentAccess != null && currentAccess.Access == access ? "selected" : null)">
                                                @access
                                            </option>
                                        }

                                    </select>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="permissions-actions">

                <a asp-action="Index"
                   class="back-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="save-permissions-btn">
                    Save Permissions
                </button>

            </div>

        </div>

    </form>

</div>
