@model Certificate
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Add Certificate";
}

<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">My Profile</span>
            <h2>Add Certificate</h2>
        </div>

        <div class="form-centered">
            <form class="contact-form" asp-action="AddCertificate" asp-controller="Profile" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-row">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" placeholder="e.g. AWS Certified Solutions Architect" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="IssuingOrganization"></label>
                    <input asp-for="IssuingOrganization" placeholder="e.g. Amazon Web Services" />
                    <span asp-validation-for="IssuingOrganization" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="CertificateNumber"></label>
                    <input asp-for="CertificateNumber" placeholder="Optional" />
                    <span asp-validation-for="CertificateNumber" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="StartDate"></label>
                    <input type="text" asp-for="StartDate" id="startDate" placeholder="Select a date" autocomplete="off" />
                    <span asp-validation-for="StartDate" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="EndDate"></label>
                    <input type="text" asp-for="EndDate" id="endDate" placeholder="Select a date" autocomplete="off" />
                    <span asp-validation-for="EndDate" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" placeholder="Optional"></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label>Attach document (PDF or Word, max 10MB)</label>
                    <input type="file" name="file" accept=".pdf,.doc,.docx" />
                    <span class="field-error">@ViewData.ModelState["file"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>

                <button type="submit" class="btn-dark">Save Certificate</button>
            </form>

            <p style="text-align:center; margin-top:16px; font-size:0.9rem;">
                <a href="/profile?tab=certificates">Cancel</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        $(function () {
            $("#startDate, #endDate").datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true
            });
        });
    </script>
}
