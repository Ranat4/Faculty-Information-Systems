@model CvRecord
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Add CV";
}

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">My Profile</span>
            <h2>Add CV</h2>
        </div>

        <div class="form-centered">
            <form class="contact-form" asp-action="AddCv" asp-controller="Profile" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-row">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" placeholder="e.g. Academic CV" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" placeholder="Optional"></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Date"></label>
                    <input asp-for="Date" type="date" />
                    <span asp-validation-for="Date" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label>Attach document (PDF or Word, max 10MB)</label>
                    <input type="file" name="file" accept=".pdf,.doc,.docx" />
                    <span class="field-error">@ViewData.ModelState["file"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>

                <button type="submit" class="btn-dark">Save CV</button>
            </form>

            <p style="text-align:center; margin-top:16px; font-size:0.9rem;">
                <a href="/profile?tab=cv">Cancel</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}