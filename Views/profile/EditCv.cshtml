@model CvRecord
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Edit CV";
}

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">My Profile</span>
            <h2>Edit CV</h2>

            <p style="font-size:0.85rem; color:var(--ink-soft);">
                Status: <strong>@Model.Status</strong>

                @if (!string.IsNullOrEmpty(Model.ReviewComment))
                {
                    <br />
                    <em>Reviewer comment: @Model.ReviewComment</em>
                }
            </p>
        </div>

        <div class="form-centered">
            <form class="contact-form"
                  asp-action="EditCv"
                  asp-controller="Profile"
                  asp-route-id="@Model.Id"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="form-row">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" />
                    <span asp-validation-for="Title"
                          class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description">@Model.Description</textarea>
                    <span asp-validation-for="Description"
                          class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Date"></label>
                    <input asp-for="Date" type="date" />
                    <span asp-validation-for="Date"
                          class="field-error"></span>
                </div>

                <div class="form-row">
                    <label>Attach document (PDF or Word, max 10MB)</label>

                    <input type="file"
                           name="file"
                           accept=".pdf,.doc,.docx" />

                    <span class="field-error">
                        @ViewData.ModelState["file"]?.Errors.FirstOrDefault()?.ErrorMessage
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <div class="form-row">
                        <label>Current file</label>

                        <a href="@Model.FilePath" target="_blank">
                            @Model.FileName
                        </a>
                    </div>
                }

                <button type="submit" class="btn-dark">
                    Save changes
                </button>
            </form>

            <p style="text-align:center; margin-top:16px; font-size:0.9rem;">
                <a href="/profile?tab=cv">Cancel</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}