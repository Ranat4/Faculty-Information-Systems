@model ProfessionalDevelopment
@{
    Layout = "_PanelLayout";
    ViewData["Title"] = "Edit Professional Development";
}

<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">

<section class="section">
    <div class="wrap">
        <div class="section-head">
            <span class="eyebrow">My Profile</span>
            <h2>Edit Professional Development</h2>

            <p style="font-size:0.85rem; color:var(--ink-soft);">
                Status: <strong>@Model.Status</strong>
                @if (!string.IsNullOrEmpty(Model.ReviewComment))
                {
                    <br /><em>Reviewer comment: @Model.ReviewComment</em>
                }
            </p>
        </div>

        <div class="form-centered">
            <form class="contact-form" asp-action="EditProfessionalDevelopment" asp-controller="Profile" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

                <div class="form-row">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="ActivityType"></label>
                    <select asp-for="ActivityType" asp-items="Html.GetEnumSelectList<ProfessionalDevelopmentType>()"></select>
                    <span asp-validation-for="ActivityType" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Organizer"></label>
                    <input asp-for="Organizer" />
                    <span asp-validation-for="Organizer" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Location"></label>
                    <input asp-for="Location" />
                    <span asp-validation-for="Location" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="Role"></label>
                    <select asp-for="Role" asp-items="Html.GetEnumSelectList<ParticipationRole>()"></select>
                    <span asp-validation-for="Role" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="StartDate"></label>
                    <input type="text" asp-for="StartDate" id="startDate" autocomplete="off" />
                    <span asp-validation-for="StartDate" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="EndDate"></label>
                    <input type="text" asp-for="EndDate" id="endDate" autocomplete="off" />
                    <span asp-validation-for="EndDate" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label asp-for="DurationHours"></label>
                    <input asp-for="DurationHours" />
                    <span asp-validation-for="DurationHours" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label style="display:flex; align-items:center; gap:8px; font-weight:normal;">
                        <input type="checkbox" asp-for="CertificateReceived" style="width:auto;" />
                        <span>@Html.DisplayNameFor(m => m.CertificateReceived)</span>
                    </label>
                </div>

                <div class="form-row">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description">@Model.Description</textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                <div class="form-row">
                    <label>Attach document (PDF or Word, max 10MB)</label>
                    <input type="file" name="file" accept=".pdf,.doc,.docx" />
                    <span class="field-error">@ViewData.ModelState["file"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <div class="form-row">
                        <label>Current file</label>
                        <a href="@Model.FilePath" target="_blank">@Model.FileName</a>
                    </div>
                }

                <button type="submit" class="btn-dark">Save changes</button>
            </form>

            <p style="text-align:center; margin-top:16px; font-size:0.9rem;">
                <a href="/profile?tab=professional-development">Cancel</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script>
        $(function () {
            $("#startDate, #endDate").datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true
            });
        });
    </script>
}
